{
  "schemaVersion": 1,
  "id": "minecolonies",
  "version": "${version}",
  "name": "MineColonies (Fabric)",
  "description": "Unofficial Fabric 26.3 port of MineColonies, bundling Structurize, BlockUI and Domum Ornamentum. Not supported by the MineColonies team.",
  "authors": ["LDT Team"],
  "contact": {
    "homepage": "https://minecolonies.com",
    "sources": "https://github.com/ldtteam/minecolonies"
  },
  "license": "GPL-3.0",
  "icon": "minecolonies_logo.png",
  "environment": "*",
  "provides": ["structurize", "blockui", "domum_ornamentum"],
  "entrypoints": {
    "main": ["com.minecolonies.fabric.MineColoniesFabric"],
    "client": ["com.minecolonies.fabric.MineColoniesFabricClient", "com.ldtteam.blockui.fabric.BlockUIFabricClient", "com.ldtteam.domumornamentum.fabric.DomumOrnamentumFabricClient"],
    "jei_mod_plugin": ["com.minecolonies.core.compatibility.jei.JEIPlugin"],
    "journeymap": ["com.minecolonies.core.compatibility.journeymap.JourneymapPlugin"]
  },
  "mixins": [
    "minecolonies-shim.mixins.json",
    "minecolonies.mixins.json",
    "structurize.mixins.json",
    "blockui.mixins.json",
    "domumornamentum.mixins.json"
  ],
  "accessWidener": "minecolonies.classtweaker",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "journeymap": "*"
  }
}
