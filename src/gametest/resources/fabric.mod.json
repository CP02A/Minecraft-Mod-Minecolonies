{
  "schemaVersion": 1,
  "id": "minecolonies-gametest",
  "version": "1.0.0",
  "name": "MineColonies Game Tests",
  "description": "End-to-end tests for the MineColonies Fabric port: server game tests, watch mode and UI tests. Development only, not shipped.",
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.minecolonies.gametest.framework.E2EBootstrap"
    ],
    "fabric-gametest": [
      "com.minecolonies.gametest.TransferBridgeGameTests",
      "com.minecolonies.gametest.framework.FrameworkGuardTests",
      "com.minecolonies.gametest.suites.ColonyConnectionsRobustnessTests",
      "com.minecolonies.gametest.suites.ConstructionResearchTests",
      "com.minecolonies.gametest.suites.CitizensServicesTests",
      "com.minecolonies.gametest.suites.LogisticsCraftingTests",
      "com.minecolonies.gametest.suites.FarmingGatheringTests",
      "com.minecolonies.gametest.suites.DefenseVisitorsTests",
      "com.minecolonies.gametest.ui.UiColonySetup"
    ],
    "fabric-client-gametest": [
      "com.minecolonies.gametest.client.WatchClientGameTest",
      "com.minecolonies.gametest.client.UiClientGameTest"
    ]
  },
  "mixins": [
    "minecolonies-gametest.mixins.json"
  ],
  "depends": {
    "minecolonies": "*",
    "fabric-gametest-api-v1": "*",
    "fabric-transfer-api-v1": "*"
  }
}
